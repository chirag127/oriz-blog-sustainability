---
/**
 * /  — "Compost" homepage. ARCHETYPE: TIMELINE / GROWTH.
 *
 * The page is a single vertical growth-stem running down the centre. The Season
 * Ring is the seed at the top; each post is a NODE on the stem, branching
 * left / right alternately like leaves off a shoot. A moss-green line connects
 * every node; leaf-buds mark each branch. This is deliberately NOT the sibling
 * top-nav card grid, and NOT a centred magazine column of hairline strata.
 *
 *   Mobile: the stem shifts to the left gutter and every node branches right
 *   (a climbing vine), so nothing is cramped on narrow screens.
 *
 * Verticals (Kitchen/Repair/Verify/Grow/Field) each carry a marker colour
 * (--v-*) on their bud + kicker. Content loading is unchanged from before.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
// The whole feed becomes the growth timeline (newest = freshest shoot at top).
const timeline = allPosts.slice(0, 12)

const seriesAll = await getSeriesWithCounts()
const inProgress: { name: string; slug: string; count: number; latest: Date }[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  inProgress.push({ name: series, slug: slugifyTag(series), count, latest })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const now = new Date()
const dateline = now.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1d ago'
  if (days < 30) return `${days}d ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1mo ago'
  if (months < 12) return `${months}mo ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1y ago' : `${years}y ago`
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}

// Season ring — the seed the stem grows from. Northern-hemisphere seasons.
const SEASONS = ['Spring', 'Summer', 'Autumn', 'Winter'] as const
const monthSeason = [3, 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3]
const seasonIdx = monthSeason[now.getMonth()]
const seasonName = SEASONS[seasonIdx]
const R = 52
const CIRC = 2 * Math.PI * R
const QUARTER = CIRC / 4
const GAP = 7
---

<BaseLayout
  title="Compost — a sustainable-living notebook"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="growth">
    {/* ── Seed: hero thesis + Season Ring at the head of the stem ─────── */}
    <section class="seed" aria-label="Introduction">
      <div class="seed-ring" role="img" aria-label={`Current season: ${seasonName}`}>
        <svg viewBox="0 0 130 130" class="ring-svg" aria-hidden="true">
          <circle class="ring-track" cx="65" cy="65" r={R} />
          {SEASONS.map((_, i) => (
            <circle
              class={`ring-arc ${i === seasonIdx ? 'is-current' : ''}`}
              cx="65"
              cy="65"
              r={R}
              stroke-dasharray={`${QUARTER - GAP} ${CIRC - (QUARTER - GAP)}`}
              stroke-dashoffset={-(i * QUARTER)}
            />
          ))}
          <circle class="ring-seed" cx="65" cy="65" r="5" />
        </svg>
        <span class="ring-label mono">{seasonName}</span>
      </div>

      <p class="seed-eyebrow mono">A sustainable-living notebook</p>
      <h1 class="seed-headline">
        Live lightly. <span class="seed-em">Waste less</span>, verify the claims, and mend what breaks.
      </h1>
      <p class="seed-sub">
        Practical habits over guilt. Every note is something you can do this week — read the bin,
        check the label, fix the thing you were about to throw out.
      </p>
      <p class="seed-dateline mono">
        <span class="seed-dot" aria-hidden="true"></span>
        {seasonName} · {dateline} · <span class="count">{allPosts.length}</span> field notes
      </p>
    </section>

    {/* ── The growth timeline: central stem, posts branching L/R ──────── */}
    <ol class="stem" aria-label="Field notes, newest first">
      {timeline.map((p, i) => {
        const v = postVertical(p)
        const side = i % 2 === 0 ? 'r' : 'l'
        const rt = p.data.readingTime ?? readingTimeFor(p)
        return (
          <li class="node" data-side={side} data-vertical={v}>
            <span class="node-branch" aria-hidden="true"></span>
            <span class="node-bud" aria-hidden="true"></span>
            <a class="node-card" href={`/blog/${p.id}`}>
              <span class="node-kicker mono">
                <span class="node-tick" aria-hidden="true"></span>{verticalLabel(v)}
              </span>
              <span class="node-title">{p.data.title}</span>
              <span class="node-dek">{p.data.description}</span>
              <span class="node-meta mono">
                <time datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toISOString().slice(0, 10)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{rt}</span>
              </span>
            </a>
          </li>
        )
      })}
      {/* stem terminus — a root marker pointing to the archive */}
      <li class="node node-root">
        <span class="node-branch" aria-hidden="true"></span>
        <a class="root-link" href="/archive/">
          Down to the roots — all {allPosts.length} notes in the archive →
        </a>
      </li>
    </ol>

    {/* ── Understory: threads-in-progress + desks, off the main stem ──── */}
    <section class="understory" aria-label="More to browse">
      {inProgress.length > 0 && (
        <div class="under-block">
          <h2 class="under-h mono">Threads still growing</h2>
          <ul class="thread-list">
            {inProgress.map((s) => (
              <li>
                <a class="thread-link" href={`/series/${s.slug}/`}>
                  <span class="thread-name">{s.name}</span>
                  <span class="thread-meta mono">{s.count} parts · {ago(s.latest)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {cats.length > 0 && (
        <div class="under-block">
          <h2 class="under-h mono">Desks</h2>
          <p class="desk-row">
            {cats.map((c, i) => (
              <>
                {i > 0 && <span class="desk-sep" aria-hidden="true">·</span>}
                <a
                  href={`/categories/${slugifyTag(c.category)}/`}
                  class="desk-link"
                  data-vertical={verticalFor(c.category)}
                >
                  <span class="desk-name">{c.category}</span>
                  <span class="desk-count mono">({c.count})</span>
                </a>
              </>
            ))}
          </p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .growth {
    max-width: 940px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  /* ── Seed / hero ─────────────────────────────────────────────────── */
  .seed {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    padding-block: clamp(2.25rem, 6vw, 3.75rem) 1rem;
  }
  .seed-ring {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .ring-svg {
    width: clamp(96px, 18vw, 128px);
    height: auto;
    transform: rotate(-90deg);
  }
  .ring-track { fill: none; stroke: var(--rule); stroke-width: 1; }
  .ring-arc { fill: none; stroke: var(--rule-strong); stroke-width: 6; stroke-linecap: round; }
  .ring-arc.is-current { stroke: var(--accent); }
  .ring-seed { fill: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .ring-arc.is-current { animation: ring-breathe 5.5s var(--ease-in-out) infinite; transform-origin: 65px 65px; }
    .ring-seed { animation: seed-pulse 5.5s var(--ease-in-out) infinite; transform-origin: 65px 65px; }
  }
  @keyframes ring-breathe { 0%, 100% { opacity: 0.72; } 50% { opacity: 1; } }
  @keyframes seed-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.22); } }
  .ring-label {
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--accent); font-weight: 700;
  }
  .seed-eyebrow {
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ink-mute); margin: 0 0 0.9rem;
  }
  .seed-headline {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(2rem, 5.2vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.07;
    color: var(--ink);
    margin: 0;
    max-width: 20ch;
  }
  .seed-em { font-style: italic; color: var(--accent); }
  .seed-sub {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 2vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 1.1rem 0 0;
    max-width: 52ch;
  }
  .seed-dateline {
    display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center;
    gap: 0.45rem;
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-mute);
    margin: 1.4rem 0 0;
  }
  .seed-dateline .count { color: var(--ink); }
  .seed-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); flex: 0 0 auto; }

  /* ── The stem (the archetype) ────────────────────────────────────── */
  .stem {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    position: relative;
  }
  /* central growth line, drawn behind the nodes */
  .stem::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 3.5rem;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--accent) 70%, transparent),
      color-mix(in oklab, var(--accent) 45%, var(--rule)) 88%,
      transparent
    );
  }

  .node {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: clamp(1.1rem, 2.5vw, 1.75rem);
    --v: var(--v-personal);
  }
  .node[data-vertical='dev'] { --v: var(--v-dev); }
  .node[data-vertical='finance'] { --v: var(--v-finance); }
  .node[data-vertical='culture'] { --v: var(--v-culture); }
  .node[data-vertical='health'] { --v: var(--v-health); }

  /* card lands in the left or right column depending on side */
  .node[data-side='r'] .node-card { grid-column: 2; padding-left: 2rem; text-align: left; }
  .node[data-side='l'] .node-card { grid-column: 1; padding-right: 2rem; text-align: right; align-items: flex-end; }

  /* the branch: a hairline reaching from the central stem out to the card */
  .node-branch {
    position: absolute;
    top: 2.1rem;
    height: 2px;
    width: calc(50% - 1.75rem);
    background: color-mix(in oklab, var(--v) 62%, var(--rule));
  }
  .node[data-side='r'] .node-branch { left: 50%; }
  .node[data-side='l'] .node-branch { right: 50%; }

  /* the bud: a leaf-shaped node sitting on the central stem */
  .node-bud {
    position: absolute;
    top: calc(2.1rem - 6px);
    left: 50%;
    width: 13px;
    height: 13px;
    transform: translateX(-50%) rotate(45deg);
    border-radius: 50% 50% 50% 0;
    background: var(--v);
    box-shadow: 0 0 0 3px var(--paper), 0 0 0 4px color-mix(in oklab, var(--v) 40%, transparent);
    z-index: 1;
  }

  .node-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--ink);
    text-decoration: none;
  }
  .node-kicker {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--v); font-weight: 500;
  }
  .node[data-side='l'] .node-kicker { flex-direction: row-reverse; }
  .node-tick { width: 6px; height: 6px; background: var(--v); flex: 0 0 auto; border-radius: 50% 50% 50% 0; transform: rotate(45deg); }
  .node-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
  }
  .node-card:hover .node-title { color: var(--accent); }
  .node-dek {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-mute);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    max-width: 44ch;
  }
  .node-meta {
    display: inline-flex; gap: 0.5rem;
    font-size: 11px; letter-spacing: 0.05em; color: var(--ink-mute);
  }
  .node[data-side='l'] .node-meta { flex-direction: row-reverse; }

  /* root terminus */
  .node-root { grid-template-columns: 1fr; justify-items: center; padding-top: 1.5rem; }
  .node-root .node-branch {
    display: block;
    position: static;
    width: 2px;
    height: 2.25rem;
    background: color-mix(in oklab, var(--accent) 55%, var(--rule));
    margin: 0 auto 0.75rem;
  }
  .root-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .root-link:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── Understory ──────────────────────────────────────────────────── */
  .understory {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 2.25rem;
  }
  @media (min-width: 768px) { .understory { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .under-h {
    font-family: var(--font-mono);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--ink-mute); font-weight: 500; margin: 0 0 1rem;
  }
  .thread-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.65rem; }
  .thread-link {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 0.75rem;
    color: var(--ink); text-decoration: none; padding-left: 1rem; position: relative;
  }
  .thread-link::before {
    content: '';
    position: absolute; left: 0; top: 0.55em;
    width: 7px; height: 7px; border-radius: 50% 50% 50% 0;
    transform: rotate(45deg); background: var(--accent);
  }
  .thread-name { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em; }
  .thread-link:hover .thread-name { color: var(--accent); }
  .thread-meta { font-family: var(--font-mono); font-size: 11px; color: var(--ink-mute); letter-spacing: 0.04em; }

  .desk-row { margin: 0; line-height: 2; color: var(--ink); }
  .desk-link { --v: var(--v-personal); color: var(--ink); text-decoration: none; margin-inline: 0.125rem; }
  .desk-link[data-vertical='dev'] { --v: var(--v-dev); }
  .desk-link[data-vertical='finance'] { --v: var(--v-finance); }
  .desk-link[data-vertical='culture'] { --v: var(--v-culture); }
  .desk-link[data-vertical='health'] { --v: var(--v-health); }
  .desk-link:hover .desk-name { color: var(--v); }
  .desk-name { font-family: var(--font-display); font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
  .desk-count { color: var(--ink-mute); font-family: var(--font-mono); font-size: 11px; margin-left: 0.25rem; }
  .desk-sep { color: var(--rule); margin-inline: 0.55rem; }

  /* ── Mobile: stem climbs the left gutter, every node branches right ── */
  @media (max-width: 640px) {
    .stem::before { left: 7px; transform: none; }
    .node { grid-template-columns: 1fr; padding-left: 2.25rem; padding-block: 1.25rem; }
    .node[data-side='r'] .node-card,
    .node[data-side='l'] .node-card {
      grid-column: 1; padding-left: 0; padding-right: 0;
      text-align: left; align-items: flex-start;
    }
    .node[data-side='l'] .node-kicker,
    .node[data-side='l'] .node-meta { flex-direction: row; }
    .node-branch {
      top: 1.75rem !important;
      left: 7px !important;
      right: auto !important;
      width: 1.4rem;
    }
    .node-bud { top: calc(1.75rem - 6px); left: 7px; }
    .node-root { padding-left: 0; }
    .node-root .node-branch { position: static; margin-left: 7px; }
  }
</style>
