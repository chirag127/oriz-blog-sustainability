---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — a thin LEAF-RULE, not a nav bar.
 *
 *   Compost 🌱 ─────────────────────────────────────── Grow · Verify · … ⌘K
 *   ╰── the header IS the top of the growth-stem: a hairline that grows a leaf.
 *
 * Deliberately NOT the sibling top-nav card-grid masthead. No centered
 * LATEST/SERIES/TAGS/ABOUT block. The stem starts here and runs down the page;
 * the "nav" reads as desks growing off the rule. On the archive/reading pages
 * the same thin rule persists so the whole family shares the growth metaphor.
 */
import Wordmark from '~/components/Wordmark.astro'

const path = Astro.url.pathname
const isCurrent = (test: (p: string) => boolean) => (test(path) ? 'page' : undefined)
---

<StatusBanner />
<header class="leaf-rule" transition:persist="site-header">
  <div class="lr-inner">
    <div class="lr-brand">
      <Wordmark subtitle="notebook" size={20} href="/" />
    </div>

    {/* the stem-rule: a hairline that the leaf grows from, spanning the gap */}
    <span class="lr-stem" aria-hidden="true">
      <svg viewBox="0 0 24 12" class="lr-leaf" focusable="false" aria-hidden="true">
        <path class="lr-leaf-fill" d="M2 6 C10 -1 18 -1 22 6 C18 13 10 13 2 6 Z" />
        <path class="lr-leaf-vein" d="M2 6 H22" />
      </svg>
    </span>

    <nav class="lr-nav" aria-label="Desks">
      <a href="/" aria-current={isCurrent((p) => p === '/')}>Grow</a>
      <a href="/series/" aria-current={isCurrent((p) => p.startsWith('/series'))}>Threads</a>
      <a href="/tags/" aria-current={isCurrent((p) => p.startsWith('/tags'))}>Roots</a>
      <a href="/about/" aria-current={isCurrent((p) => p.startsWith('/about'))}>About</a>
    </nav>

    <div class="lr-search"><MultiSearch client:idle /></div>
    <div class="lr-controls"><HeaderControls client:idle /></div>
  </div>
</header>

<style>
  .leaf-rule {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(150%) blur(9px);
    -webkit-backdrop-filter: saturate(150%) blur(9px);
    /* the signature: header bottom edge is a moss-green hairline (the stem head) */
    border-bottom: 1px solid var(--rule);
    box-shadow: 0 1px 0 0 color-mix(in oklab, var(--accent) 34%, transparent);
  }
  .lr-inner {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }
  .lr-brand { flex: 0 0 auto; display: inline-flex; align-items: center; }

  /* the growth-stem hairline connecting mark → desks; the leaf sits on it */
  .lr-stem {
    display: none;
    position: relative;
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(
      to right,
      color-mix(in oklab, var(--accent) 55%, transparent),
      var(--rule) 60%,
      transparent
    );
    margin-inline: 0.9rem;
  }
  .lr-leaf {
    position: absolute;
    left: 14%;
    top: 50%;
    width: 22px;
    height: 11px;
    transform: translateY(-50%);
    overflow: visible;
  }
  .lr-leaf-fill { fill: color-mix(in oklab, var(--accent) 82%, var(--paper)); }
  .lr-leaf-vein { stroke: color-mix(in oklab, var(--accent) 45%, var(--paper)); stroke-width: 0.8; fill: none; }
  @media (prefers-reduced-motion: no-preference) {
    .lr-leaf { animation: leaf-sway 6s var(--ease-in-out) infinite; transform-origin: left center; }
  }
  @keyframes leaf-sway {
    0%, 100% { transform: translateY(-50%) rotate(0deg); }
    50% { transform: translateY(-50%) rotate(-4deg); }
  }

  .lr-nav {
    display: none;
    align-items: center;
    gap: 1.15rem;
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .lr-nav a {
    position: relative;
    padding-block: 0.35rem;
    color: var(--ink-mute);
    text-decoration: none;
    transition: color var(--dur-fast, 120ms) ease;
  }
  .lr-nav a:hover { color: var(--accent); }
  /* growth marker under the active desk — a tiny sprout tick, not an underline bar */
  .lr-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 5px;
    height: 5px;
    border-radius: 50% 50% 50% 0;
    background: var(--accent);
    transform: translateX(-50%) scale(0) rotate(45deg);
    transition: transform var(--dur-fast, 120ms) var(--ease-out);
  }
  .lr-nav a:hover::after,
  .lr-nav a[aria-current='page']::after { transform: translateX(-50%) scale(1) rotate(45deg); }
  .lr-nav a[aria-current='page'] { color: var(--accent); }

  .lr-search { margin-left: auto; display: inline-flex; align-items: center; }
  .lr-controls { display: inline-flex; align-items: center; margin-left: 0.6rem; }

  @media (min-width: 768px) {
    .lr-stem { display: block; }
    .lr-nav { display: inline-flex; }
    .lr-search { margin-left: 0.9rem; }
  }
</style>
