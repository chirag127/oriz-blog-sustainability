---
/*
 * Wordmark — "Compost" set in the display serif (Fraunces) with a living
 * sprout growing beside it — the seed-to-shoot mark that anchors the
 * sustainable-living identity. Each site owns its own mark; here it is an
 * organic italic serif wordmark with a moss-green sprout.
 */

interface Props {
  /** Sub-section name — rendered after a `·` separator. */
  subtitle?: string
  /** Display size in CSS pixels. */
  size?: number
  /** Wrap the mark in an <a href="/"> — defaults to '/' when subtitle is set. */
  href?: string | null
  /** Render as <h1> (the masthead) rather than <div>. */
  asHeading?: boolean
}

const { subtitle, size = 96, href = null, asHeading = false } = Astro.props
const Tag = asHeading ? 'h1' : ('div' as const)
---

{
  href ? (
    <a class="wordmark-link" href={href} aria-label={subtitle ? `Compost · ${subtitle}` : 'Compost'}>
      <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
        <span class="wordmark-mark">
          <span class="wordmark-sprout" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path class="wm-stem" d="M12 22 V10" />
              <path class="wm-leaf-l" d="M12 12 C6 12 4 8 4 4 C9 4 12 7 12 12 Z" />
              <path class="wm-leaf-r" d="M12 14 C17 14 19 11 19 7 C14 7 12 10 12 14 Z" />
            </svg>
          </span>
          <span class="wordmark-word">Compost</span>
        </span>
        {subtitle && (
          <>
            <span class="wordmark-sep" aria-hidden="true">·</span>
            <span class="wordmark-sub">{subtitle}</span>
          </>
        )}
      </Tag>
    </a>
  ) : (
    <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
      <span class="wordmark-mark">
        <span class="wordmark-sprout" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path class="wm-stem" d="M12 22 V10" />
            <path class="wm-leaf-l" d="M12 12 C6 12 4 8 4 4 C9 4 12 7 12 12 Z" />
            <path class="wm-leaf-r" d="M12 14 C17 14 19 11 19 7 C14 7 12 10 12 14 Z" />
          </svg>
        </span>
        <span class="wordmark-word">Compost</span>
      </span>
      {subtitle && (
        <>
          <span class="wordmark-sep" aria-hidden="true">·</span>
          <span class="wordmark-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  )
}

<style>
  .wordmark-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.22em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-optical-sizing: auto;
    font-size: var(--wm-size, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark-mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.14em;
  }
  .wordmark-sprout {
    align-self: center;
    display: inline-flex;
    width: 0.82em;
    height: 0.82em;
    flex: 0 0 auto;
  }
  .wordmark-sprout svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .wm-stem {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .wm-leaf-l,
  .wm-leaf-r {
    fill: var(--accent);
  }
  .wm-leaf-r {
    fill: color-mix(in oklab, var(--accent) 68%, var(--ink-mute));
  }
  .wordmark-word {
    font-style: italic;
  }
  .wordmark-sep {
    margin-inline: 0.16em;
    color: var(--ink-mute);
    font-weight: 400;
    font-style: normal;
  }
  .wordmark-sub {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
    font-style: normal;
    font-size: 0.42em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    align-self: center;
  }
</style>
